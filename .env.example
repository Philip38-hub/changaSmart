# Copy to .env and fill in as needed. Never commit the real .env file.
# AWS credentials themselves are NOT set here -- boto3's normal credential
# resolution (aws configure, environment variables, IAM role, etc.) is used.
# Ambiguous-case reconciliation always calls the real Strands Agent +
# Amazon Bedrock -- requires AWS credentials with bedrock:InvokeModel
# permission and model access enabled for BEDROCK_MODEL_ID below.

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# SQLite file the app persists to -- survives a process restart. Relative
# to the working directory the app is launched from (typically backend/).
DATABASE_PATH=changasmart.db

# Agent behaviour tuning (optional -- sensible defaults exist in app/config.py)
AGENT_TEMPERATURE=0.1
AUTO_MATCH_CONFIDENCE_THRESHOLD=0.90
REVIEW_CONFIDENCE_THRESHOLD=0.55

# Bedrock call resilience (optional -- see app/config.py)
BEDROCK_CONNECT_TIMEOUT_SECONDS=10
BEDROCK_READ_TIMEOUT_SECONDS=20
BEDROCK_BOTO_MAX_ATTEMPTS=1
AGENT_RETRY_MAX_ATTEMPTS=2
AGENT_RETRY_INITIAL_DELAY_SECONDS=2
AGENT_RETRY_MAX_DELAY_SECONDS=8

LOG_LEVEL=INFO
